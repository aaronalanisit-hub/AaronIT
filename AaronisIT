    "That explanation is your working model of intimacy and threat — big signal for the profile.",
  iq_center_truth:
    "That center-line is the axis I’ll use to interpret a lot of your other answers."
};

/* Storage helpers */
function storeAaronResult(){
  try{
    const payload={
      time:new Date().toISOString(),
      psyche:AARON_STATE.answers.psyche,
      iq:AARON_STATE.answers.iq,
      done:AARON_STATE.done
    };
    localStorage.setItem('aaron_it_last_run',JSON.stringify(payload));
  }catch(_){}
}

function saveProgress(){
  try{
    localStorage.setItem('aaron_it_progress', JSON.stringify({
      phase:AARON_STATE.phase,
      index:AARON_STATE.index,
      answers:AARON_STATE.answers,
      done:AARON_STATE.done
    }));
  }catch(_){}
}

function clearProgress(){
  try{ localStorage.removeItem('aaron_it_progress'); }catch(_){}
}

function getAaronContextForBackend(){
  let lastRun=null, progress=null;
  try{ lastRun = JSON.parse(localStorage.getItem('aaron_it_last_run')||'null'); }catch(_){}
  try{ progress = JSON.parse(localStorage.getItem('aaron_it_progress')||'null'); }catch(_){}
  return {
    method: AARON_METHOD_TEXT,
    benchmark: AARON_BENCHMARK_SUMMARY,
    lastRun,
    progress
  };
}

/* Heuristic: detect “two words accidentally merged” */
function detectMergedWord(ans){
  const s=(ans||'').trim();
  if(!s) return false;
  if(s.indexOf(' ')===-1 && s.length>=10) return true; // long single token
  if(/[a-z][A-Z]/.test(s)) return true;                // camelCase mash
  return false;
}

function startAaron(){
  AARON_STATE.phase='choose';
  AARON_STATE.index=0;
  AARON_STATE.answers.psyche=[];
  AARON_STATE.answers.iq=[];
  AARON_STATE.done.psyche=false;
  AARON_STATE.done.iq=false;
  addMsg(
    'bot',
    "Aaron IT+ mapping activated.\n\n"+
    "Type \"Aaron it\" to start your profile.\n\n"+
    "You can start with either:\n"+
    "- psyche  — core traits, values, relationships, meaning\n"+
    "- iq      — non-linear thought tasks (your intellect pattern)\n\n"+
    "Type \"psyche\" or \"iq\" to choose where to begin."
  );
}

/* Report generation */
async function requestAaronReport(){
  try{
    const payload = {
      psyche: AARON_STATE.answers.psyche,
      iq: AARON_STATE.answers.iq,
      done: AARON_STATE.done
    };

    const res = await fetch('/aaron-report', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });

    const data = await res.json();
    const report = data && data.report
      ? data.report
      : "No structured report returned from /aaron-report. Check your backend prompt.";

    addMsg('bot', report);
  }catch(e){
    console.error('Aaron report error:', e);
    addMsg(
      'bot',
      "There was an error generating your Aaron IT+ report.\nYour raw answers are still stored locally under the key \"aaron_it_last_run\" in this browser."
    );
  }
}

/* Normal chat: send to backend /chat (Groq or whatever) with Aaron context */
async function handleChatWithLLM(userText){
  try{
    const res=await fetch('/chat',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        message:userText,
        aaronContext:getAaronContextForBackend()
      })
    });
    const data=await res.json();
    if(data && data.reply){
      addMsg('bot',data.reply);
    }else{
      addMsg('bot',"No reply from backend /chat. Check your server or API wiring.");
    }
  }catch(e){
    console.error('Chat backend error:', e);
    addMsg('bot',"Error talking to model backend. Make sure /chat exists and your API key is set on the server.");
  }
}

/* Command + routing layer */
function processInput(txt){
  const t=txt.trim().toLowerCase();

  // Global kill switch
  if(t==='exit aaron' || t==='stop aaron'){
    if(AARON_STATE.phase!=='idle' && AARON_STATE.phase!=='done'){
      saveProgress();
      AARON_STATE.phase='idle';
      addMsg('bot',
        "Aaron IT+ mapping paused.\n"+
        "Your current spot is saved on this device.\n"+
        "Type \"resume aaron\" to continue, or \"aaron it\" to start from the beginning."
      );
    }
    return;
  }

  // Resume command
  if(t==='resume aaron' || t==='continue aaron'){
    let raw=null;
    try{ raw = localStorage.getItem('aaron_it_progress'); }catch(_){}
    if(!raw){
      addMsg('bot',"I don't see any saved Aaron IT+ progress to resume.");
      return;
    }
    try{
      const prog = JSON.parse(raw);
      AARON_RESUME_CACHE = prog;
      AARON_STATE.phase='resumePrompt';
      addMsg(
        'bot',
        "I see a partially completed Aaron IT+ run (phase: "+prog.phase+", index: "+prog.index+").\n\n"+
        "Type \"resume\" to continue from that point, or \"restart\" to begin a fresh run."
      );
    }catch(e){
      console.error('Error parsing progress:', e);
      addMsg('bot',"I tried to read the saved Aaron IT+ progress, but something went wrong parsing it.");
    }
    return;
  }

  // Help command (HELP IT)
  if(t==='help it'){
    addMsg(
      'bot',
      "Help · Aaron IT+ shell\n\n"+
      "- Normal chat: just talk — messages go to the model via /chat.\n"+
      "- aaron it: start (or configure) the psyche and intellect mapping module.\n"+
      "- psyche: run psyche profiling only.\n"+
      "- iq:     run non-linear IQ-style tasks only.\n"+
      "- method it: see what Aaron IT+ measures and how the 40–200 scale works.\n"+
      "- last aaron it: regenerate your profile from your last stored run.\n"+
      "- resume aaron: resume a partial run if one is saved.\n"+
      "- exit aaron: pause the mapping mid-run.\n"+
      "- stop and report: end the current section early and get a partial report.\n\n"+
      "Filing:\n"+
      "- Drag any user message onto the 📁 icon to file it.\n"+
      "- Click the cabinet icon to browse filed items."
    );
    return;
  }

  // Method explainer
  if(t==='method it' || t==='aaron method' || t==='how does aaron it work'){
    addMsg('bot',AARON_METHOD_TEXT);
    return;
  }

  // Regenerate from last stored run
  if(t==='last aaron it' || t==='show last aaron'){
    const raw = localStorage.getItem('aaron_it_last_run');
    if(!raw){
      addMsg('bot',"I don't have a stored Aaron IT+ run yet on this device.");
      return;
    }
    try{
      const parsed = JSON.parse(raw);
      AARON_STATE.answers.psyche = parsed.psyche || [];
      AARON_STATE.answers.iq = parsed.iq || [];
      AARON_STATE.done = parsed.done || {psyche:false,iq:false};
      AARON_STATE.phase='done';
      addMsg('bot',"Re-generating your Aaron IT+ profile from the last stored run...");
      requestAaronReport();
    }catch(e){
      console.error('Error parsing last Aaron run:', e);
      addMsg('bot',"I tried to read the last Aaron IT+ run, but something went wrong parsing the stored data.");
    }
    return;
  }

  // Start-only commands for psyche/iq when idle/done
  if((t==='psyche' || t==='start psyche') &&
      (AARON_STATE.phase==='idle' || AARON_STATE.phase==='done')){
    AARON_STATE.phase='psyche';
    AARON_STATE.index=0;
    if(!AARON_STATE.answers.psyche) AARON_STATE.answers.psyche=[];
    saveProgress();
    addMsg('bot',"Starting psyche-only pass: core traits, values, relationships, meaning.");
    const q=AARON_PSYCHE_QUESTIONS[0];
    if(q) addMsg('bot',q.text);
    return;
  }

  if((t==='iq' || t==='start iq') &&
      (AARON_STATE.phase==='idle' || AARON_STATE.phase==='done')){
    AARON_STATE.phase='iq';
    AARON_STATE.index=0;
    if(!AARON_STATE.answers.iq) AARON_STATE.answers.iq=[];
    saveProgress();
    addMsg('bot',"Starting non-linear IQ-style tasks.\nThere are "+AARON_IQ_TASKS.length+" of them.");
    const q=AARON_IQ_TASKS[0];
    if(q) addMsg('bot',q.prompt);
    return;
  }

  // Start Aaron IT+ mapping (chooser)
  if(t==='aaron it' || t==='start aaron it' || t==='run aaron it'){
    let raw=null;
    try{ raw = localStorage.getItem('aaron_it_progress'); }catch(_){}
    if(raw){
      try{
        const prog = JSON.parse(raw);
        if(prog && (prog.phase==='psyche' || prog.phase==='iq')){
          AARON_RESUME_CACHE = prog;
          AARON_STATE.phase='resumePrompt';
          addMsg(
            'bot',
            "I see a partially completed Aaron IT+ run (phase: "+prog.phase+", index: "+prog.index+").\n\n"+
            "Type \"resume\" to continue from that point, or \"restart\" to begin a fresh run."
          );
          return;
        }
      }catch(_){}
    }
    if(AARON_STATE.phase!=='idle' && AARON_STATE.phase!=='done'){
      addMsg('bot',"Aaron IT+ is already running.\nAnswer the current question, or type \"exit aaron\" to stop.");
      return;
    }
    startAaron();
    return;
  }

  // Handle resumePrompt phase
  if(AARON_STATE.phase==='resumePrompt'){
    if(t==='resume'){
      if(!AARON_RESUME_CACHE){
        addMsg('bot',"No cached progress to resume.");
        AARON_STATE.phase='idle';
        return;
      }
      AARON_STATE.phase = AARON_RESUME_CACHE.phase;
      AARON_STATE.index = AARON_RESUME_CACHE.index;
      AARON_STATE.answers = AARON_RESUME_CACHE.answers || {psyche:[],iq:[]};
      AARON_STATE.done = AARON_RESUME_CACHE.done || {psyche:false,iq:false};
      addMsg('bot',"Resuming Aaron IT+ "+AARON_STATE.phase+" where you left off.");
      if(AARON_STATE.phase==='psyche'){
        const q=AARON_PSYCHE_QUESTIONS[AARON_STATE.index];
        if(q) addMsg('bot',q.text);
      }else if(AARON_STATE.phase==='iq'){
        const q=AARON_IQ_TASKS[AARON_STATE.index];
        if(q) addMsg('bot',q.prompt);
      }else{
        addMsg('bot',"Saved state was not in psyche/iq. Starting fresh.");
        AARON_STATE.phase='idle';
        startAaron();
      }
      return;
    }
    if(t==='restart'){
      clearProgress();
      AARON_STATE.phase='idle';
      startAaron();
      return;
    }
    addMsg('bot',"Type \"resume\" to continue your partial run, or \"restart\" to begin fresh.");
    return;
  }

  // === META QUERIES WHILE IN PSYCHE / IQ (scores, report) ===
  if(AARON_STATE.phase==='psyche' || AARON_STATE.phase==='iq'){
    const phaseLabel = AARON_STATE.phase==='psyche' ? 'psyche profiling' : 'non-linear tasks';

    if(
      t.includes('score') ||
      t.includes('scores') ||
      t.includes('report') ||
      t.includes('profile') ||
      t.includes('how did i do')
    ){
      addMsg(
        'bot',
        "I won't count that as an answer.\n\n"+
        "Right now we're in the middle of the "+phaseLabel+" sequence.\n"+
        "I can generate a report after we finish this section, or if you say \"stop and report\".\n\n"+
        "If you want to keep going, answer the current question directly.\n"+
        "If you want a partial report now, type \"stop and report\"."
      );
      return;
    }

    if(t==='stop and report'){
      // Partial report with current data
      clearProgress();
      AARON_STATE.phase='done';
      storeAaronResult();
      addMsg(
        'bot',
        "Stopping here and generating a partial Aaron IT+ report based on what we have so far."
      );
      requestAaronReport();
      return;
    }
  }

  // Extra intuitive control while inside psyche/iq
  if(AARON_STATE.phase==='psyche' || AARON_STATE.phase==='iq'){
    const lt=t;

    // Switch track fresh
    if(lt.includes('switch') && lt.includes('psyche')){
      AARON_STATE.phase='psyche';
      AARON_STATE.index=0;
      AARON_STATE.answers.psyche=[];
      saveProgress();
      addMsg('bot',"Okay, switching into psyche questions from here and starting that pass fresh.");
      const q=AARON_PSYCHE_QUESTIONS[0];
      if(q) addMsg('bot',q.text);
      return;
    }
    if(lt.includes('switch') && lt.includes('iq')){
      AARON_STATE.phase='iq';
      AARON_STATE.index=0;
      AARON_STATE.answers.iq=[];
      saveProgress();
      addMsg('bot',"Okay, switching into the non-linear IQ-style tasks from here and starting that pass fresh.");
      const q=AARON_IQ_TASKS[0];
      if(q) addMsg('bot',q.prompt);
      return;
    }

    // Soft exit phrases
    if(lt.includes('stop') || lt.includes('done') || lt.includes('quit') || lt.includes('cancel')){
      saveProgress();
      AARON_STATE.phase='idle';
      addMsg('bot',
        "Stopping Aaron IT+ where it is.\n"+
        "Your answers so far are saved.\n"+
        "Use \"resume aaron\" to pick up later, or \"aaron it\" for a fresh run."
      );
      return;
    }
  }

  // Choice of starting path (chooser mode)
  if(AARON_STATE.phase==='choose'){
    if(t.includes('psyche')){
      AARON_STATE.phase='psyche';
      AARON_STATE.index=0;
      AARON_STATE.answers.psyche=[];
      saveProgress();
      addMsg('bot',"Starting with psyche.\nWe’ll map core traits, values, and relational patterns first.");
      const q=AARON_PSYCHE_QUESTIONS[0];
      if(q) addMsg('bot',q.text);
      return;
    }
    if(t==='iq' || t.includes('task') || t.includes('nonlinear') || t.includes('non-linear')){
      AARON_STATE.phase='iq';
      AARON_STATE.index=0;
      AARON_STATE.answers.iq=[];
      saveProgress();
      addMsg('bot',"Starting with non-linear thought tasks.\nThere are "+AARON_IQ_TASKS.length+" of them.");
      const q=AARON_IQ_TASKS[0];
      if(q) addMsg('bot',q.prompt);
      return;
    }
    addMsg('bot',"Type \"psyche\" to start with your story and traits, or \"iq\" to start with the non-linear tasks.");
    return;
  }

  // If we are in the middle of Aaron IT+, capture answers and advance
  if(AARON_STATE.phase==='psyche'){
    const idx = AARON_STATE.index;
    const q=AARON_PSYCHE_QUESTIONS[idx];
    if(!q){
      // Safety: no question, just end psyche and report
      AARON_STATE.done.psyche=true;
      AARON_STATE.phase='done';
      clearProgress();
      storeAaronResult();
      addMsg('bot',"Psyche set appears complete. Generating your current profile now (psyche layer).");
      requestAaronReport();
      return;
    }

    AARON_STATE.answers.psyche.push({id:q.id,question:q.text,answer:txt});

    const fb = AARON_PSYCHE_FEEDBACK[q.id] || "Thanks for answering that honestly. That one carries a lot of signal.";

    AARON_STATE.index = idx+1;

    if(AARON_STATE.index < AARON_PSYCHE_QUESTIONS.length){
      const nextQ = AARON_PSYCHE_QUESTIONS[AARON_STATE.index];
      addMsg('bot', fb + "\n\nNext:\n" + nextQ.text);
      saveProgress();
    }else{
      // Psyche complete → STOP, report, then OFFER IQ
      AARON_STATE.done.psyche=true;
      AARON_STATE.phase='done';
      clearProgress();
      storeAaronResult();
      addMsg(
        'bot',
        fb + "\n\nPsyche profile captured.\nGenerating your current profile now (psyche layer)."
      );
      requestAaronReport();
      if(!AARON_STATE.done.iq){
        addMsg(
          'bot',
          "When you're ready, we can also run the non-linear IQ-style tasks.\nType \"iq\" to start them."
        );
      }
    }
    return;
  }

  if(AARON_STATE.phase==='iq'){
    const idx = AARON_STATE.index;
    const q=AARON_IQ_TASKS[idx];
    if(!q){
      // Safety: no question; finalize
      AARON_STATE.done.iq=true;
      AARON_STATE.phase='done';
      clearProgress();
      storeAaronResult();
      addMsg('bot',"IQ task list appears complete. Generating your current profile now (IQ-analog layer).");
      requestAaronReport();
      if(!AARON_STATE.done.psyche){
        addMsg(
          'bot',
          "If you’d like, we can also run the psyche profile.\nType \"psyche\" to do that next."
        );
      }
      return;
    }

    AARON_STATE.answers.iq.push({id:q.id,question:q.prompt,answer:txt});

    const fb = AARON_IQ_FEEDBACK[q.id] || "Got it. That answer gives me a clear read on how your mind moves here.";

    if(detectMergedWord(txt)){
      addMsg(
        'bot',
        "Quick note: it looks like you may have merged two words there.\n"+
        "If that was an accident, you can re-answer this question in your own words.\n"+
        "If it was intentional, I’ll treat it as part of your style."
      );
    }

    AARON_STATE.index = idx+1;

    if(AARON_STATE.index < AARON_IQ_TASKS.length){
      const nextQ = AARON_IQ_TASKS[AARON_STATE.index];
      addMsg('bot', fb + "\n\nNext task:\n" + nextQ.prompt);
      saveProgress();
    }else{
      AARON_STATE.done.iq=true;
      AARON_STATE.phase='done';
      clearProgress();
      storeAaronResult();
      addMsg(
        'bot',
        fb + "\n\nAaron IT+ non-linear tasks complete.\nGenerating your current profile now (IQ-analog layer)."
      );
      requestAaronReport();
      if(!AARON_STATE.done.psyche){
        addMsg(
          'bot',
          "If you’d like, we can also run the psyche profile.\nType \"psyche\" to do that next."
        );
      }
    }
    return;
  }

  // Otherwise: normal chat mode
  handleChatWithLLM(txt);
}

/* Wire form submission to processInput */
form.addEventListener('submit',e=>{
  e.preventDefault();
  const txt=input.value.trim();
  if(!txt)return;
  addMsg('user',txt);
  input.value='';
  processInput(txt);
});

