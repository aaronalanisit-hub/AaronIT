/* Store completed run so nothing is lost */
function storeAaronResult(){
  try{
    const payload={
      time:new Date().toISOString(),
      psyche:AARON_STATE.answers.psyche,
      iq:AARON_STATE.answers.iq
    };
    localStorage.setItem('aaron_it_last_run',JSON.stringify(payload));
  }catch(_){}
}

/* Heuristic: detect “two words accidentally merged” */
function detectMergedWord(ans){
  const s=(ans||'').trim();
  if(!s) return false;
  // One long token, no spaces, likely accidental mash
  if(s.indexOf(' ')===-1 && s.length>=10) return true;
  // camelCase mash
  if(/[a-z][A-Z]/.test(s)) return true;
  return false;
}

function startAaron(){
  AARON_STATE.phase='choose';
  AARON_STATE.index=0;
  AARON_STATE.answers.psyche=[];
  AARON_STATE.answers.iq=[];
  addMsg(
    'bot',
    "Aaron IT+ mapping activated.\n\n"+
    "You can start with either:\n"+
    "- psyche  — core traits, values, relationships, meaning\n"+
    "- iq      — non-linear thought tasks (your intellect pattern)\n\n"+
    "Type \"psyche\" or \"iq\" to choose where to begin."
  );
}

function askNextAaronQuestion(){
  if(AARON_STATE.phase==='psyche'){
    if(AARON_STATE.index < AARON_PSYCHE_QUESTIONS.length){
      const q=AARON_PSYCHE_QUESTIONS[AARON_STATE.index].text;
      addMsg('bot',q);
      return;
    }else{
      AARON_STATE.phase='iq';
      AARON_STATE.index=0;
      addMsg('bot',
        "Psyche profile captured.\n\n"+
        "Now we’ll run a set of non-linear thought tasks.\n"+
        "There are "+AARON_IQ_TASKS.length+" of them."
      );
    }
  }

  if(AARON_STATE.phase==='iq'){
    if(AARON_STATE.index < AARON_IQ_TASKS.length){
      const q=AARON_IQ_TASKS[AARON_STATE.index].prompt;
      addMsg('bot',q);
      return;
    }else{
      AARON_STATE.phase='done';
      storeAaronResult();
      addMsg(
        'bot',
        "Aaron IT+ mapping complete.\n\nGenerating your profile and index now..."
      );
      requestAaronReport();
    }
  }
}

/* Call backend /aaron-report to score + generate profile */
async function requestAaronReport(){
  try{
    const payload = {
      psyche: AARON_STATE.answers.psyche,
      iq: AARON_STATE.answers.iq
    };

    const res = await fetch('/aaron-report', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });

    const data = await res.json();
    const report = data && data.report
      ? data.report
      : "No structured report returned from /aaron-report. Check your backend prompt.";

    addMsg('bot', report);
  }catch(e){
    console.error('Aaron report error:', e);
    addMsg(
      'bot',
      "There was an error generating your Aaron IT+ report.\nYour raw answers are still stored locally under the key \"aaron_it_last_run\" in this browser."
    );
  }
}

/* Normal chat: send to backend /chat (Groq) */
async function handleChatWithLLM(userText){
  try{
    const res=await fetch('/chat',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({message:userText})
    });
    const data=await res.json();
    if(data && data.reply){
      addMsg('bot',data.reply);
    }else{
      addMsg('bot',"No reply from backend /chat. Check your server or API wiring.");
    }
  }catch(e){
    console.error('Chat backend error:', e);
    addMsg('bot',"Error talking to model backend. Make sure /chat exists and your API key is set on the server.");
  }
}

/* Command + routing layer */
function processInput(txt){
  const t=txt.trim().toLowerCase();

  // Global kill switch
  if(t==='exit aaron' || t==='stop aaron'){
    if(AARON_STATE.phase!=='idle' && AARON_STATE.phase!=='done'){
      AARON_STATE.phase='idle';
      addMsg('bot',"Aaron IT+ mapping paused.\nYou can type \"aaron it\" to restart from the beginning.");
    }
    return;
  }

  // Help command (HELP IT)
  if(t==='help it'){
    addMsg(
      'bot',
      "Help · Aaron IT+ shell\n\n"+
      "- Normal chat: just talk — messages go to the Groq-backed assistant.\n"+
      "- aaron it: start the psyche and intellect mapping module.\n"+
      "- method it: see what Aaron IT+ measures and how the 40–200 scale works.\n"+
      "- last aaron it: regenerate your profile from your last stored run on this device.\n"+
      "- exit aaron: pause the mapping mid-run.\n\n"+
      "Filing:\n"+
      "- Drag any message onto the 📁 icon to file it.\n"+
      "- Click the cabinet icon to browse filed items."
    );
    return;
  }

  // Method explainer
  if(t==='method it' || t==='aaron method' || t==='how does aaron it work'){
    addMsg('bot',AARON_METHOD_TEXT);
    return;
  }

  // Regenerate from last stored run
  if(t==='last aaron it' || t==='show last aaron'){
    const raw = localStorage.getItem('aaron_it_last_run');
    if(!raw){
      addMsg('bot',"I don't have a stored Aaron IT+ run yet on this device.");
      return;
    }
    try{
      const parsed = JSON.parse(raw);
      AARON_STATE.answers.psyche = parsed.psyche || [];
      AARON_STATE.answers.iq = parsed.iq || [];
      AARON_STATE.phase='done';
      addMsg('bot',"Re-generating your Aaron IT+ profile from the last stored run...");
      requestAaronReport();
    }catch(e){
      console.error('Error parsing last Aaron run:', e);
      addMsg('bot',"I tried to read the last Aaron IT+ run, but something went wrong parsing the stored data.");
    }
    return;
  }

  // Start Aaron IT+ mapping
  if(t==='aaron it' || t==='start aaron it' || t==='run aaron it'){
    if(AARON_STATE.phase!=='idle' && AARON_STATE.phase!=='done'){
      addMsg('bot',"Aaron IT+ is already running.\nAnswer the current question, or type \"exit aaron\" to stop.");
      return;
    }
    startAaron();
    return;
  }

  // Extra intuitive control while inside psyche/iq
  if(AARON_STATE.phase==='psyche' || AARON_STATE.phase==='iq'){
    const lt=t;

    // Switch track
    if(lt.includes('switch') && lt.includes('psyche')){
      AARON_STATE.phase='psyche';
      AARON_STATE.index=0;
      AARON_STATE.answers.psyche=[];
      addMsg('bot',"Okay, switching into psyche questions from here and starting that pass fresh.");
      askNextAaronQuestion();
      return;
    }
    if(lt.includes('switch') && lt.includes('iq')){
      AARON_STATE.phase='iq';
      AARON_STATE.index=0;
      AARON_STATE.answers.iq=[];
      addMsg('bot',"Okay, switching into the non-linear IQ-style tasks from here and starting that pass fresh.");
      askNextAaronQuestion();
      return;
    }

    // Soft exit phrases
    if(lt.includes('stop') || lt.includes('done') || lt.includes('quit') || lt.includes('cancel')){
      AARON_STATE.phase='idle';
      addMsg('bot',"Stopping Aaron IT+ where it is.\nYour answers so far are still stored locally.\nYou can type \"aaron it\" later to start a fresh run.");
      return;
    }
  }

  // Choice of starting path
  if(AARON_STATE.phase==='choose'){
    if(t.includes('psyche')){
      AARON_STATE.phase='psyche';
      AARON_STATE.index=0;
      addMsg('bot',"Starting with psyche.\nWe’ll map core traits, values, and relational patterns first.");
      askNextAaronQuestion();
      return;
    }
    if(t==='iq' || t.includes('task') || t.includes('nonlinear') || t.includes('non-linear')){
      AARON_STATE.phase='iq';
      AARON_STATE.index=0;
      addMsg('bot',"Starting with non-linear thought tasks.\nThere are "+AARON_IQ_TASKS.length+" of them.");
      askNextAaronQuestion();
      return;
    }
    addMsg('bot',"Type \"psyche\" to start with your story and traits, or \"iq\" to start with the non-linear tasks.");
    return;
  }

  // If we are in the middle of Aaron IT+, capture answers and advance
  if(AARON_STATE.phase==='psyche'){
    const q=AARON_PSYCHE_QUESTIONS[AARON_STATE.index];
    AARON_STATE.answers.psyche.push({id:q.id,question:q.text,answer:txt});
    AARON_STATE.index++;
    askNextAaronQuestion();
    return;
  }

  if(AARON_STATE.phase==='iq'){
    const q=AARON_IQ_TASKS[AARON_STATE.index];
    AARON_STATE.answers.iq.push({id:q.id,question:q.prompt,answer:txt});

    // Inline encouragement
    const fb = AARON_IQ_FEEDBACK[q.id];
    if(fb) addMsg('bot', fb);

    // Flag likely merged-word accident
    if(detectMergedWord(txt)){
      addMsg(
        'bot',
        "Quick note: it looks like you may have merged two words there.\nIf that was an accident, you can re-answer this question in your own words.\nIf it was intentional, I’ll treat it as part of your style."
      );
    }

    AARON_STATE.index++;
    askNextAaronQuestion();
    return;
  }

  // Otherwise: normal chat mode
  handleChatWithLLM(txt);
}

/* Wire form submission to processInput */
form.addEventListener('submit',e=>{
  e.preventDefault();
  const txt=input.value.trim();
  if(!txt)return;
  addMsg('user',txt);
  input.value='';
  processInput(txt);
});

